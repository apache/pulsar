<!--
  The events of every Netty buffer allocation and free, which a component records when its profiling settings list
  this file, jfrConfigurations: [profile, pulsar.jfc, netty-allocations.jfc], such as with
  configs/profile-broker-netty-allocations.yaml. They are recorded for every buffer, without stack traces, so they add
  overhead to the profiled JVM and make its recording much larger: in the IoT telemetry max-rate scenario, about 2.5
  events of each kind per message, and a broker recording of 1 GB instead of 10 MB. Prefer a short measurement.
-->
<configuration version="2.0" label="Netty allocation events" description="Every Netty buffer allocation and free">
  <category label="Netty">
    <event name="io.netty.AllocateBuffer">
      <setting name="enabled">true</setting>
      <setting name="stackTrace">false</setting>
      <setting name="threshold">0 ns</setting>
    </event>
    <event name="io.netty.FreeBuffer">
      <setting name="enabled">true</setting>
      <setting name="stackTrace">false</setting>
      <setting name="threshold">0 ns</setting>
    </event>
  </category>
</configuration>
