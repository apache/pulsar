<!--
  The launcher's console shows only its own messages: the run's phases and progress. Every log, among them
  Testcontainers' and the Pulsar containers' own logs, goes to launcher.log in the run directory, which the launcher
  names in performance.launcher.log before anything logs.
-->
<Configuration xmlns="http://logging.apache.org/log4j/2.0/config" status="WARN">
  <Appenders>
    <File name="FILE" fileName="${sys:performance.launcher.log:-build/performance-launcher.log}" createOnDemand="true">
      <PatternLayout pattern="%d{ISO8601_OFFSET_DATE_TIME_HHMM} [%t] %-5level %logger{36} - %msg%equals{ %X}{ {}}{}%n"/>
    </File>
  </Appenders>
  <Loggers>
    <Root level="info">
      <AppenderRef ref="FILE"/>
    </Root>
  </Loggers>
</Configuration>
