<!--
  The workloads' log: the Pulsar client's warnings, such as its reconnections and timeouts, which show how the clients
  went through a network fault. It goes to pulsar-client.log.txt in the workload's output directory, created only
  when something is logged, so that the container's output keeps only the workload's own lines, which the launcher
  reads. PULSAR_CLIENT_LOG_LEVEL in the workload's env, such as info, sets another level.
-->
<Configuration xmlns="http://logging.apache.org/log4j/2.0/config" status="WARN">
  <Appenders>
    <!-- Not flushed on every line: a network fault can make the clients log thousands of lines in a second, on the
         threads that also send and receive the messages. Log4j flushes the rest when the workload exits. -->
    <File name="FILE" fileName="/performance-output/pulsar-client.log.txt" createOnDemand="true"
          immediateFlush="false">
      <PatternLayout pattern="%d{ISO8601_OFFSET_DATE_TIME_HHMM} [%t] %-5level %logger{36} - %msg%equals{ %X}{ {}}{}%n"/>
    </File>
  </Appenders>
  <Loggers>
    <Root level="${env:PULSAR_CLIENT_LOG_LEVEL:-warn}">
      <AppenderRef ref="FILE"/>
    </Root>
  </Loggers>
</Configuration>
